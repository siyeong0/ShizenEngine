#include "Common.hlsli"
#include "BxDF.hlsli"
#include "Shadow.hlsli"
#include "VolumetricFogCommon.hlsli"

// GBuffer inputs
Texture2D<float4> g_GBuffer0; // Albedo.rgb, Opacity.a
Texture2D<float4> g_GBuffer1; // Normal packed 0..1 (world), w unused
Texture2D<float4> g_GBuffer2; // Metallic, Roughness, AO, AlphaCoverage
Texture2D<float4> g_GBuffer3; // Emissive.rgb, ShadingModel in a (asfloat/model)
Texture2D<float> g_GBufferDepth; // Depth (D3D 0..1)

// Screen-space shadow (0..1, 1=lit)
Texture2D<float> g_ContactShadowMap;

// Screen-space ambient occlusion (0..1, 1=no occlusion)
Texture2D<float> g_AmbientOcclusionMap;

// Volumetric fog
Texture3D<float4> g_FogVolume; // rgb=L, a=T

struct PSInput
{
	float4 Pos : SV_POSITION;
	float2 UV : TEXCOORD0;
};

// ------------------------------------------------------------
// Foliage lighting add-on (deferred friendly)
// ------------------------------------------------------------
static float3 EvaluateFoliageAddon(
	float3 N,
	float3 V,
	float3 L,
	float3 baseColor,
	float roughness,
	float shadow,
	float3 lightColor,
	float lightIntensity)
{
	float NoL = saturate(dot(N, L));

	const float wrap = 0.40;
	float wrapNoL = saturate((dot(N, L) + wrap) / (1.0 + wrap));

	float back = saturate(dot(-N, L));
	float backScatter = pow(back, 2.0) * (1.0 - roughness);

	float darkSide = 1.0 - NoL;
	float wrapStrength = lerp(0.25, 0.55, darkSide);
	const float backStrength = 0.55;

	float3 add = baseColor * (wrapNoL * wrapStrength + backScatter * backStrength);

	float shadowFront = saturate(shadow);
	float shadowBack = lerp(1.0, shadowFront, 0.2);
	add *= lerp(shadowBack, shadowFront, NoL);

	float upWeight = saturate(dot(N, float3(0, 1, 0)));
	upWeight = lerp(0.35, 1.0, upWeight);
	add *= upWeight;

	return add * lightColor * lightIntensity;
}

// ------------------------------------------------------------
// Main
// ------------------------------------------------------------
void main(in PSInput PSIn, out float4 OutColor : SV_TARGET0)
{
	float2 uv = PSIn.UV;

	float depth01 = g_GBufferDepth.Sample(g_LinearClampSampler, uv);

	// Background / sky pixels
	if (depth01 >= 0.999999)
	{
		float3 dirWS = ReconstructWorldRayDir(uv);
		float3 sky = g_EnvMapTex.Sample(g_LinearClampSampler, dirWS).rgb;
		OutColor = float4(sky, 1.0);
		return;
	}

	float4 gb0 = g_GBuffer0.Sample(g_LinearClampSampler, uv);
	float4 gb1 = g_GBuffer1.Sample(g_LinearClampSampler, uv);
	float4 gb2 = g_GBuffer2.Sample(g_LinearClampSampler, uv);
	float4 gb3 = g_GBuffer3.Sample(g_LinearClampSampler, uv);

	float3 baseColor = gb0.rgb;
	float opacity = gb0.a;

	float3 N = UnpackNormal01(gb1.xyz);

	float metallic = saturate(gb2.x);
	float roughness = saturate(gb2.y);
	float aoMaterial = saturate(gb2.z);

	float3 emissive = gb3.rgb;
	uint shadingModel = DecodeShadingModel_U8(gb3.a);

	float3 worldPos = ReconstructWorldPos(uv, depth01);

	float3 V = normalize(g_FrameCB.CameraPosition - worldPos);
	float3 L = normalize(-g_FrameCB.LightDirWS);

	// ------------------------------------------------------------
	// SSAO
	// ------------------------------------------------------------
	float ssao = g_AmbientOcclusionMap.Sample(g_LinearClampSampler, uv);
	float aoCombined = saturate(aoMaterial * ssao);

	// ------------------------------------------------------------
	// Shadow (CSM + contact shadow)
	// ------------------------------------------------------------
	float3 ddxWorldPos = ddx(worldPos);
	float3 ddyWorldPos = ddy(worldPos);

	float3 viewPos = mul(float4(worldPos, 1.0), g_FrameCB.View).xyz;
	float cameraViewSpaceZ = viewPos.z;
	bool filterAcrossCascades = true;

	FilteredShadow sh = FilterShadowMapCSM(
		worldPos,
		ddxWorldPos,
		ddyWorldPos,
		cameraViewSpaceZ,
		filterAcrossCascades);
	float shadowCSM = sh.LightAmount;

	float contactShadow = g_ContactShadowMap.Sample(g_LinearClampSampler, uv);
	
	float shadowFinal = shadowCSM * contactShadow; // 0..1 visibility

	// ------------------------------------------------------------
	// Policy knobs (you can make these constants/CB params)
	// ------------------------------------------------------------
	float indirectScale = 0.25;
	float directScale = 1.0;

	// ------------------------------------------------------------
	// Shading model branching
	// ------------------------------------------------------------
	float3 hdr = 0;
	if (shadingModel == DEFAULT_LIT)
	{
		float3 lightRadiance = g_FrameCB.LightColor * g_FrameCB.LightColor;
		float3 direct = ShadeDirect(N, V, L, lightRadiance, baseColor, metallic, roughness, shadowFinal);
		float3 indirect = ShadeIndirectIBL(N, V, baseColor, metallic, roughness, aoCombined);

		hdr = direct * directScale + indirect * indirectScale + emissive;
	}
	else if (shadingModel == FOLIAGE)
	{
		// Foliage fixes
		metallic = 0.0;
		roughness = clamp(roughness, 0.35, 0.85);

		float coverage = saturate(gb2.w);
		indirectScale = 0.30;
		directScale = 0.95;

		float3 lightRadiance = g_FrameCB.LightColor * g_FrameCB.LightColor;
		float3 direct = ShadeDirect(N, V, L, lightRadiance, baseColor, metallic, roughness, shadowFinal);
		float3 indirect = ShadeIndirectIBL(N, V, baseColor, metallic, roughness, aoCombined);

		hdr = direct * directScale + indirect * indirectScale + emissive;

		hdr += EvaluateFoliageAddon(
			normalize(N),
			normalize(V),
			normalize(L),
			baseColor,
			roughness,
			shadowFinal,
			g_FrameCB.LightColor,
			g_FrameCB.LightIntensity);
	}
	else
	{
		// ASSERT(false);
		hdr = baseColor;
	}
	
	// ------------------------------------------------------------
	// Volumetric Fog Apply (froxel volume sampled by viewZ)
	// ------------------------------------------------------------
	float3 viewPosFog = mul(float4(worldPos, 1.0), g_FrameCB.View).xyz;
	float viewZFog = max(viewPosFog.z, 1e-4);

	float tFog = TFromViewZ(viewZFog);
	float4 fogLT = g_FogVolume.Sample(g_LinearClampSampler, float3(uv, tFog));

	float3 fogL = fogLT.rgb;
	float fogT = saturate(fogLT.a);
	hdr = hdr * fogT + fogL;
	
	// 
	hdr *= g_FrameCB.PreExposure;
	OutColor = float4(hdr, opacity);
	
	if (g_FrameCB.FunctionFlags & 1 << 0)
	{
		OutColor = float4(baseColor, 1.0);
	}
	
	if (g_FrameCB.FunctionFlags & 1 << 1)
	{
		OutColor = float4(N * 0.5 + 0.5, 1.0);
	}
	
	if (g_FrameCB.FunctionFlags & 1 << 4)
	{
		OutColor = float4(shadowCSM.xxx, 1.0);
	}
	
	if (g_FrameCB.FunctionFlags & 1 << 4)
	{
		OutColor = float4(contactShadow.xxx, 1.0);
	}
	
	if (g_FrameCB.FunctionFlags & 1 << 4)
	{
		OutColor = float4(fogL.xxx, 1.0);
	}
}

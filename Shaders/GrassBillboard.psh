#include "HLSL_Structures.hlsli"
#include "Shadow.hlsli"

cbuffer FRAME_CONSTANTS
{
    FrameConstants g_FrameCB;
};

Texture2D<float> g_SceneDepth;
SamplerState g_PointClampSampler;

Texture2D g_BaseColorTex;
SamplerState g_LinearWrapSampler;

struct PSInput
{
    float4 Pos : SV_Position;
    float3 PosWS : TEXCOORD0;
    float3 NormalWS : TEXCOORD1;
    float2 UV : TEXCOORD2;
};

float4 main(PSInput IN) : SV_TARGET0
{
    float2 sceneUV = IN.Pos.xy * g_FrameCB.InvViewportSize;
    float sceneDepth = g_SceneDepth.SampleLevel(g_PointClampSampler, sceneUV, 0);
    if (IN.Pos.z > sceneDepth + 1e-4)
        discard;

    float4 tex = g_BaseColorTex.SampleBias(g_LinearWrapSampler, IN.UV, -0.75f);
    float3 baseColor = tex.rgb;
    float alpha = tex.a;

    alpha = saturate((alpha - 0.02f) / (1.0f - 0.02f));
    alpha = pow(alpha, 0.60f);

    float3 N = normalize(IN.NormalWS);
    float3 L = normalize(-g_FrameCB.LightDirWS);

    float ndlWrap = saturate((dot(N, L) + 0.8f) / (1.0f + 0.8f));

    float3 lightRGB = g_FrameCB.LightColor * g_FrameCB.LightIntensity;

    // ------------------------------------------------------------
    // Day/Night scaling (very cheap)
    // - if intensity is high => dayScale ~= 1
    // - if intensity is low  => nightScale ~= NIGHT_MIN
    // Tune thresholds based on your day/night curve
    // ------------------------------------------------------------
    const float NIGHT_MIN = 0.12f;
    const float DAY_START_I = 0.25f;
    const float DAY_FULL_I = 1.00f; 

    float day01 = smoothstep(DAY_START_I, DAY_FULL_I, g_FrameCB.LightIntensity);
    float dnScale = lerp(NIGHT_MIN, 1.0f, day01);

    float3 lit = baseColor * lightRGB * ndlWrap * 0.5f * dnScale;

    return float4(lit, alpha);
}

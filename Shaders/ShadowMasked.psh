#include "HLSL_Structures.hlsli"
#include "Common.hlsli"

cbuffer MATERIAL_CONSTANTS
{
    float4 g_BaseColorFactor; // rgb = base color, a = opacity
    float3 g_EmissiveFactor; // emissive rgb
    float g_EmissiveIntensity; // scalar

    float g_RoughnessFactor; // scalar
    float g_NormalScale; // scalar
    float g_OcclusionStrength; // scalar
    float g_AlphaCutoff; // scalar (for MASK)

    float g_MetallicFactor; // scalar
    uint g_MaterialFlags; // bitmask HAS_* + ALPHA_MODE bits
    uint2 _pad0; // 16-byte align
}

Texture2D g_BaseColorTex;

struct PSInput
{
    float4 Pos : SV_POSITION;
    float2 UV : TEXCOORD0;
};

void main(in PSInput PSIn)
{
    const float ALPHA_CUTOFF = 0.5;
    if (g_MaterialFlags & MAT_HAS_BASECOLOR)
    {
        float alphaCutoff = 0.3f;

        float alpha = g_BaseColorFactor.a * g_BaseColorTex.Sample(g_LinearWrapSampler, PSIn.UV).a;
        float denom = max(1.0f - alphaCutoff, 1e-6f);
        float coverage = saturate((alpha - alphaCutoff) / denom);
        // Alpha cutout (MASK)
        float t = DitherThreshold4x4(SVPosToPixel(PSIn.Pos));
        
        // ---- A2C-like quantize + stochastic rounding ----
	    // N=4면 4x MSAA 느낌, N=8이면 더 부드러움
        static const float SAMPLE = 4.0f;

        float x = coverage * SAMPLE;
        float base = floor(x); // 0..N
        float frac = x - base; // 0..1

        float k = base + ((t < frac) ? 1.0f : 0.0f);
        float coverageQ = saturate(k / SAMPLE);

	    // ---- Final alpha test (clip) ----
        float mask = (coverageQ >= t) ? 1.0f : 0.0f;
        clip(mask - 0.5f);
    }
}

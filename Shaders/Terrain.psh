#include "Common.hlsli"
#include "PBRMaterial.hlsli"
#include "TerrainCommon.hlsli"

Texture2D g_SoilBaseColorTex;
Texture2D g_SoilNormalTex;
Texture2D g_SoilRoughnessTex;
Texture2D g_SoilAmbientOcclusionTex;
Texture2D g_SoilDisplacementTex;

Texture2D g_RockyBaseColorTex;
Texture2D g_RockyNormalTex;
Texture2D g_RockyRoughnessTex;
Texture2D g_RockyAmbientOcclusionTex;
Texture2D g_RockyDisplacementTex;

Texture2D g_GravelBaseColorTex;
Texture2D g_GravelNormalTex;
Texture2D g_GravelRoughnessTex;
Texture2D g_GravelAmbientOcclusionTex;
Texture2D g_GravelDisplacementTex;

// -----------------------------------------------------------------------------
// Controls (tune later; can be moved to material constants)
// -----------------------------------------------------------------------------
static const float MICRO_METERS_PER_TILE = 4.0f; // Micro detail scale (meters per tile)
static const float RAND_CELL_METERS = 8.0f; // Randomization cell size (meters)
static const float MACRO_NOISE_METERS = 64.0f; // Low-frequency noise scale (meters)

static const float FADE_START_METERS = 30.0f; // Start fading micro detail
static const float FADE_END_METERS = 140.0f; // Fully faded micro detail

static const float MIP_BIAS_NEAR = 0.0f;
static const float MIP_BIAS_FAR = 2.0f;

static const float MACRO_TINT_STRENTH_BASE = 0.25f;

// -----------------------------------------------------------------------------
// POM controls (applies to soil/rock/gravel)
// -----------------------------------------------------------------------------
static const float POM_HEIGHT_METERS = 0.2f;
static const float POM_FADE_START = 6.0f;
static const float POM_FADE_END = 25.0f;
static const int POM_STEPS_MIN = 8;
static const int POM_STEPS_MAX = 16;

static const float POM_EDGE_START = 0.06f;
static const float POM_EDGE_END = 0.22f;

static const float POM_GRAZE_Z_MIN = 0.18f;

// -----------------------------------------------------------------------------
// Small helpers
// -----------------------------------------------------------------------------
static float Hash12(float2 p)
{
    // Cheap hash in [0,1)
	return frac(sin(dot(p, float2(127.1f, 311.7f))) * 43758.5453f);
}

static float2 Hash22(float2 p)
{
	float h1 = frac(sin(dot(p, float2(127.1f, 311.7f))) * 43758.5453f);
	float h2 = frac(sin(dot(p, float2(269.5f, 183.3f))) * 43758.5453f);
	return float2(h1, h2);
}

// 4x4 Bayer thresholds in [0,1). (Ordered dithering)
static const float BAYER4x4[16] =
{
	0.0f / 16.0f, 8.0f / 16.0f, 2.0f / 16.0f, 10.0f / 16.0f,
    12.0f / 16.0f, 4.0f / 16.0f, 14.0f / 16.0f, 6.0f / 16.0f,
     3.0f / 16.0f, 11.0f / 16.0f, 1.0f / 16.0f, 9.0f / 16.0f,
    15.0f / 16.0f, 7.0f / 16.0f, 13.0f / 16.0f, 5.0f / 16.0f
};

static float DitherThreshold4x4(float2 svPosXY, uint frameIndex)
{
    // Move pattern each frame to cooperate with TAA (avoid ¡°stuck¡± pattern).
    // If you have a dedicated TAA jitter index, you can swap in that instead.
	int ix = (int) svPosXY.x;
	int iy = (int) svPosXY.y;

	ix = (ix + (int) (frameIndex & 3u)) & 3;
	iy = (iy + (int) ((frameIndex >> 2) & 3u)) & 3;

	int idx = ix + (iy << 2);
	return BAYER4x4[idx];
}

// -----------------------------------------------------------------------------
// POM helper (UV in [0..1), wraps internally via frac())
// heightTex: displacement (NOTE: you inverted in-loop; keep as your convention)
// -----------------------------------------------------------------------------
static float2 ApplyPOM_UV(float2 baseUV01, Texture2D heightTex, float mipBias, float3 viewDirTS, float pomFade)
{
	if (pomFade <= 0.0f)
		return baseUV01;

	float3 v = viewDirTS;
	float vz = max(abs(v.z), POM_GRAZE_Z_MIN);

	float angleT = saturate(1.0f - vz);
	int steps = (int) lerp((float) POM_STEPS_MIN, (float) POM_STEPS_MAX, angleT);
	steps = max(steps, 4);

	float stepSize = 1.0f / (float) steps;

	float heightScaleUV = (POM_HEIGHT_METERS / MICRO_METERS_PER_TILE) * pomFade;
	float2 parDir = (v.xy / vz) * heightScaleUV;

	float2 uv = baseUV01;
	float layer = 0.0f;

	float h = heightTex.SampleBias(g_LinearWrapSampler, uv, mipBias).r;

    [loop]
	for (int i = 0; i < steps; ++i)
	{
		layer += stepSize;
		uv -= parDir * stepSize;

		uv = frac(uv);
        // Your convention: invert here (white=high) -> (1 - sample)
		h = 1.0f - heightTex.SampleBias(g_LinearWrapSampler, uv, mipBias).r;

		if (layer >= h)
			break;
	}

	float2 uvPrev = frac(uv + parDir * stepSize);
	float layerPrev = layer - stepSize;
	float hPrev = heightTex.SampleBias(g_LinearWrapSampler, uvPrev, mipBias).r;

	float a = (layerPrev - hPrev);
	float b = (layer - h);
	float w = a / (a - b + 1e-6f);

	return frac(lerp(uv, uvPrev, saturate(w)));
}

// -----------------------------------------------------------------------------
// Randomized micro tiling sampler + POM (optimized):
// - Computes one cell's transform and returns UV + gradients for SampleGrad reuse.
// - Samples all textures using SampleGrad (mip correctness under flip/rot).
// -----------------------------------------------------------------------------
struct MicroUVGrad
{
	float2 uv01;
	float2 ddx_uv;
	float2 ddy_uv;
};

static MicroUVGrad BuildMicroUVGrad(float2 ci, float3 worldPos, float mipBias)
{
    // Hash -> random parameters per cell.
	float2 h = Hash22(ci);
	float h1 = h.x;
	float h2 = h.y;

    // Random offset in meters within the cell [0..RAND_CELL_METERS).
	float2 offM = frac(float2(h1, h2)) * RAND_CELL_METERS;

    // Rotation index 0..3 (90-degree steps).
	int rotIdx = (int) floor(frac(h1 * 13.37f) * 4.0f);

    // Mirror flags in {-1,+1}
	float mx = (frac(h2 * 7.91f) < 0.5f) ? -1.0f : 1.0f;
	float my = (frac(h1 * 5.37f) < 0.5f) ? -1.0f : 1.0f;

    // Base micro UV in "tiles"
	float2 uvM = (worldPos.xz + offM) / MICRO_METERS_PER_TILE;

    // World-space derivatives for correct mip under transforms
	float2 dUVdx = ddx(worldPos.xz) / MICRO_METERS_PER_TILE;
	float2 dUVdy = ddy(worldPos.xz) / MICRO_METERS_PER_TILE;

    // Apply mirror
	uvM.x *= mx;
	uvM.y *= my;
	dUVdx.x *= mx;
	dUVdx.y *= my;
	dUVdy.x *= mx;
	dUVdy.y *= my;

    // Apply rotation (90-degree)
	float2 u = uvM;
	float2 dudx = dUVdx;
	float2 dudy = dUVdy;

	if (rotIdx == 1)
	{
		u = float2(uvM.y, -uvM.x);
		dudx = float2(dUVdx.y, -dUVdx.x);
		dudy = float2(dUVdy.y, -dUVdy.x);
	}
	else if (rotIdx == 2)
	{
		u = float2(-uvM.x, -uvM.y);
		dudx = float2(-dUVdx.x, -dUVdx.y);
		dudy = float2(-dUVdy.x, -dUVdy.y);
	}
	else if (rotIdx == 3)
	{
		u = float2(-uvM.y, uvM.x);
		dudx = float2(-dUVdx.y, dUVdx.x);
		dudy = float2(-dUVdy.y, dUVdy.x);
	}

    // Apply mip bias by scaling gradients (equivalent-ish to LOD bias)
	float gradScale = exp2(mipBias);
	dudx *= gradScale;
	dudy *= gradScale;

	MicroUVGrad o;
	o.uv01 = frac(u);
	o.ddx_uv = dudx;
	o.ddy_uv = dudy;
	return o;
}

static void SampleLayerSet_Grad(
    MicroUVGrad g,
    Texture2D bcTex,
    Texture2D nTex,
    Texture2D rTex,
    Texture2D aoTex,
    out float3 outBC,
    out float outR,
    out float outAO,
    out float3 outNTS)
{
	outBC = bcTex.SampleGrad(g_LinearWrapSampler, g.uv01, g.ddx_uv, g.ddy_uv).rgb;
	outR = rTex.SampleGrad(g_LinearWrapSampler, g.uv01, g.ddx_uv, g.ddy_uv).r;
	outAO = aoTex.SampleGrad(g_LinearWrapSampler, g.uv01, g.ddx_uv, g.ddy_uv).r;
	outNTS = nTex.SampleGrad(g_LinearWrapSampler, g.uv01, g.ddx_uv, g.ddy_uv).xyz * 2.0f - 1.0f;
}

static void SampleCellVariant_Optimized(
    float2 ci,
    float3 worldPos,
    float mipBias,
    float3 viewDirTS,
    float pomFade,
    out float3 outSoilBC,
    out float3 outRockBC,
    out float3 outGravelBC,
    out float outSoilR,
    out float outRockR,
    out float outGravelR,
    out float outSoilAO,
    out float outRockAO,
    out float outGravelAO,
    out float3 outSoilNTS,
    out float3 outRockNTS,
    out float3 outGravelNTS)
{
    // Build shared micro UV + gradients once.
	MicroUVGrad gSoil = BuildMicroUVGrad(ci, worldPos, mipBias);

    // POM per-layer (UV only). Keep gradients from pre-POM (cheap & stable enough).
    // If you want perfect correctness, we can rebuild gradients after POM, but that¡¯s expensive.
	if (pomFade > 0.0f)
	{
		float2 uvSoil = ApplyPOM_UV(gSoil.uv01, g_SoilDisplacementTex, mipBias, viewDirTS, pomFade);
		float2 uvRock = ApplyPOM_UV(gSoil.uv01, g_RockyDisplacementTex, mipBias, viewDirTS, pomFade);
		float2 uvGrav = ApplyPOM_UV(gSoil.uv01, g_GravelDisplacementTex, mipBias, viewDirTS, pomFade);

		MicroUVGrad gRock = gSoil;
		gRock.uv01 = uvRock;
		MicroUVGrad gGrav = gSoil;
		gGrav.uv01 = uvGrav;
		gSoil.uv01 = uvSoil;

		SampleLayerSet_Grad(gSoil, g_SoilBaseColorTex, g_SoilNormalTex, g_SoilRoughnessTex, g_SoilAmbientOcclusionTex, outSoilBC, outSoilR, outSoilAO, outSoilNTS);
		SampleLayerSet_Grad(gRock, g_RockyBaseColorTex, g_RockyNormalTex, g_RockyRoughnessTex, g_RockyAmbientOcclusionTex, outRockBC, outRockR, outRockAO, outRockNTS);
		SampleLayerSet_Grad(gGrav, g_GravelBaseColorTex, g_GravelNormalTex, g_GravelRoughnessTex, g_GravelAmbientOcclusionTex, outGravelBC, outGravelR, outGravelAO, outGravelNTS);
	}
	else
	{
		SampleLayerSet_Grad(gSoil, g_SoilBaseColorTex, g_SoilNormalTex, g_SoilRoughnessTex, g_SoilAmbientOcclusionTex, outSoilBC, outSoilR, outSoilAO, outSoilNTS);
		SampleLayerSet_Grad(gSoil, g_RockyBaseColorTex, g_RockyNormalTex, g_RockyRoughnessTex, g_RockyAmbientOcclusionTex, outRockBC, outRockR, outRockAO, outRockNTS);
		SampleLayerSet_Grad(gSoil, g_GravelBaseColorTex, g_GravelNormalTex, g_GravelRoughnessTex, g_GravelAmbientOcclusionTex, outGravelBC, outGravelR, outGravelAO, outGravelNTS);
	}
}

BASE_PS_MAIN_ENTRY()
{
	float4 svPos = GET_PSIN_POS();
	float4 currClip = GET_PSIN_CURR_CLIP();
	float4 prevClip = GET_PSIN_PREV_CLIP();
	float3 worldPos = GET_PSIN_WORLD_POS();
	float2 globalUV = GET_PSIN_UV();
	float3 normalWS = GET_PSIN_WORLD_NORMAL();
	float3 tangentWS = GET_PSIN_WORLD_TANGENT();
	
	normalWS = SampleTerrainNormalAtWorldXZ(worldPos.xz);
	tangentWS = normalize(float3(1, 0, 0) - normalWS * normalWS.x);
	
    // -------------------------------------------------------------------------
    // Terrain weights (macro classification)
    // -------------------------------------------------------------------------
	float wSoil = SampleTerrainSoil(globalUV);
	float wRock = SampleTerrainRocky(globalUV);
	float wGravel = SampleTerrainFlow(globalUV);

    {
		float s = max(wSoil + wRock + wGravel, 1e-6f);
		float invS = rcp(s);
		wSoil *= invS;
		wRock *= invS;
		wGravel *= invS;
	}

    // -------------------------------------------------------------------------
    // Macro tint + low-frequency noise
    // -------------------------------------------------------------------------
	float3 globalDiffuse = SampleTerrainDiffuse(globalUV).rgb;

	float macroNoise01 = 0.0f;
    {
		float2 p = worldPos.xz / MACRO_NOISE_METERS;
		float2 ip = floor(p);
		float2 fp = frac(p);

		fp = fp * fp * (3.0f - 2.0f * fp);

		float h00 = Hash12(ip + float2(0.0f, 0.0f));
		float h10 = Hash12(ip + float2(1.0f, 0.0f));
		float h01 = Hash12(ip + float2(0.0f, 1.0f));
		float h11 = Hash12(ip + float2(1.0f, 1.0f));

		float hx0 = lerp(h00, h10, fp.x);
		float hx1 = lerp(h01, h11, fp.x);
		macroNoise01 = lerp(hx0, hx1, fp.y);
	}

	float macroMul = lerp(0.95f, 1.05f, macroNoise01);
	float3 macroTint = globalDiffuse * macroMul;

    // -------------------------------------------------------------------------
    // Distance fade (micro strength + mip bias)
    // -------------------------------------------------------------------------
	float2 camXZ = g_FrameCB.CameraPosition.xz;
	float distXZ = length(worldPos.xz - camXZ);

	float fadeT = saturate((distXZ - FADE_START_METERS) / max(FADE_END_METERS - FADE_START_METERS, 1e-6f));
	float microStrength = 1.0f - fadeT;

	float mipBias = lerp(MIP_BIAS_NEAR, MIP_BIAS_FAR, fadeT);

    // -------------------------------------------------------------------------
    // TBN + viewDirTS (compute once, orthonormal)
    // -------------------------------------------------------------------------
	float3 N = normalize(normalWS);
	float3 T = normalize(tangentWS);
	T = normalize(T - N * dot(T, N));
	float3 B = normalize(cross(N, T));

	float3 viewDirWS = normalize(g_FrameCB.CameraPosition - worldPos);
	float3 viewDirTS = normalize(float3(dot(viewDirWS, T), dot(viewDirWS, B), dot(viewDirWS, N)));

    // -------------------------------------------------------------------------
    // POM fade (distance + cell-edge + graze)
    // -------------------------------------------------------------------------
	float pomFade = 0.0f;
    {
		float distFade = smoothstep(POM_FADE_END, POM_FADE_START, distXZ); // 1 near -> 0 far

		float2 cellP2 = worldPos.xz / RAND_CELL_METERS;
		float2 cellF2 = frac(cellP2);

		float edgeDist01 = min(min(cellF2.x, 1.0f - cellF2.x), min(cellF2.y, 1.0f - cellF2.y));
		float edgeFade = smoothstep(POM_EDGE_START, POM_EDGE_END, edgeDist01);

		float grazeFade = saturate((abs(viewDirTS.z) - POM_GRAZE_Z_MIN) / max(1.0f - POM_GRAZE_Z_MIN, 1e-6f));

		float wAny = max(wSoil, max(wRock, wGravel));

		pomFade = distFade * edgeFade * grazeFade * saturate(wAny * 2.0f);
		pomFade = pomFade * pomFade;
	}

    // -------------------------------------------------------------------------
    // Randomized micro tiling (DITHERED 1-CELL SELECTION)
    // - Instead of sampling 4 corners + bilerp, select one corner per pixel.
    // - Requires TAA for best results (pattern averages out temporally).
    // -------------------------------------------------------------------------
	float2 cellP = worldPos.xz / RAND_CELL_METERS;
	float2 cellI = floor(cellP);
	float2 cellF = frac(cellP);

    // Original blend weights
	float2 b = smoothstep(0.25f, 0.75f, cellF);

    // Dither threshold (same for x/y is fine, but we can decorrelate slightly)
	float thr = DitherThreshold4x4(svPos.xy, g_FrameCB.FrameIndex);

    // Quantize blend weights into {0,1} via dither threshold (techartnomad 704)
	b = saturate(sign(b - thr));

    // Select one of {00,10,01,11}
	float2 ci = cellI + b;

	float3 soilBC, rockBC, gravelBC;
	float soilR, rockR, gravelR;
	float soilAO, rockAO, gravelAO;
	float3 soilNTS, rockNTS, gravelNTS;

	SampleCellVariant_Optimized(
        ci,
        worldPos,
        mipBias,
        viewDirTS,
        pomFade,
        soilBC, rockBC, gravelBC,
        soilR, rockR, gravelR,
        soilAO, rockAO, gravelAO,
        soilNTS, rockNTS, gravelNTS
    );

    // -------------------------------------------------------------------------
    // Layer blend (weight-only)
    // -------------------------------------------------------------------------
	float3 layerBC = soilBC * wSoil + rockBC * wRock + gravelBC * wGravel;

	float fadeTint = lerp(MACRO_TINT_STRENTH_BASE, 1.0f, fadeT);
	float3 baseColor = lerp(layerBC, macroTint, fadeTint);
	baseColor *= g_BaseColorFactor.rgb;

	float alpha = 1.0f;
	float coverage = ClipPixelCoverage(alpha, svPos);

	float roughness = saturate((soilR * wSoil + rockR * wRock + gravelR * wGravel) * g_RoughnessFactor);
	float metallic = 0.0f;

	float ao = soilAO * wSoil + rockAO * wRock + gravelAO * wGravel;
	ao = lerp(1.0f, ao, saturate(g_OcclusionStrength));

	float3 emissive = g_EmissiveFactor * g_EmissiveIntensity;

    // -------------------------------------------------------------------------
    // Normal (NormalDX decode + micro fade)
    // -------------------------------------------------------------------------
	float normalScale = g_NormalScale * microStrength;

	soilNTS.xy *= normalScale;
	rockNTS.xy *= normalScale;
	gravelNTS.xy *= normalScale;

	soilNTS.z = sqrt(saturate(1.0f - dot(soilNTS.xy, soilNTS.xy)));
	rockNTS.z = sqrt(saturate(1.0f - dot(rockNTS.xy, rockNTS.xy)));
	gravelNTS.z = sqrt(saturate(1.0f - dot(gravelNTS.xy, gravelNTS.xy)));

	float3 nTS = normalize(soilNTS * wSoil + rockNTS * wRock + gravelNTS * wGravel);
	float3 normal = normalize(nTS.x * T + nTS.y * B + nTS.z * N);

    // Velocity
	float2 currUV = ClipToUV(currClip);
	float2 prevUV = ClipToUV(prevClip);

    SET_PSOUT_ALBEDO(baseColor);
    SET_PSOUT_OPACITY(alpha);
    SET_PSOUT_NORMAL(normal);
    SET_PSOUT_METALLIC(metallic);
    SET_PSOUT_ROUGHNESS(roughness);
    SET_PSOUT_AO(ao);
    SET_PSOUT_ALPHACOVERAGE(coverage);
    SET_PSOUT_EMISSIVE(emissive);
    SET_PSOUT_VELOCITY(currUV - prevUV);
    SET_PSOUT_SHADING_MODEL(DEFAULT_LIT);
}
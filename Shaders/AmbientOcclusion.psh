#include "Common.hlsli"

// Inputs (same style as ContactShadow)
Texture2D<float> g_GBufferDepth; // D3D depth 0..1
Texture2D<float4> g_GBufferNormal; // packed 0..1 (world)

struct PSInput
{
    float4 Pos : SV_POSITION;
    float2 UV : TEXCOORD0;
};

// -----------------------------------------------------------------------------
// GTAO Tunables (start with these; later move to CB if you want)
// -----------------------------------------------------------------------------
static const float GTAO_RADIUS_WS = 1.5;
static const int GTAO_NUM_DIRECTIONS = 8;
static const int GTAO_NUM_STEPS = 6;

static const float GTAO_BIAS_WS = 0.06;
static const float GTAO_MIN_HORIZON_COS = 0.18;
static const float GTAO_POWER = 1.55;
static const float GTAO_INTENSITY = 1.25;

static const float GTAO_FADE_START_WS = 20.0;
static const float GTAO_FADE_END_WS = 35.0;

static const float GTAO_MAX_DIST_WS = 3.0;
static const float GTAO_OCCLUDER_NDOT_V = 0.00;


// -----------------------------------------------------------------------------
// Helpers (match ContactShadow style)
// -----------------------------------------------------------------------------
static float4 WorldToClip(float3 ws)
{
    return mul(float4(ws, 1.0f), g_FrameCB.ViewProj);
}

static bool IsInsideScreen(float2 uv)
{
    return all(uv >= 0.0f) && all(uv <= 1.0f);
}

static float ViewDistanceFade(float3 ws)
{
    float d = length(ws - g_FrameCB.CameraPosition);
    return saturate((GTAO_FADE_END_WS - d) / max(GTAO_FADE_END_WS - GTAO_FADE_START_WS, 1e-3f));
}

// Stable world tangent basis from N (world)
static void BuildOrthoBasis(float3 N, out float3 T, out float3 B)
{
    float3 up = (abs(N.y) < 0.999f) ? float3(0, 1, 0) : float3(1, 0, 0);
    T = normalize(cross(up, N));
    B = cross(N, T);
}

// Random rotation (blue-noise)
static float2 Rotate2D(float2 v, float2 rotUnit)
{
    return float2(
        v.x * rotUnit.x - v.y * rotUnit.y,
        v.x * rotUnit.y + v.y * rotUnit.x
    );
}

// -----------------------------------------------------------------------------
// GTAO horizon evaluation for one direction
// - We sample along a projected ray in screen space that corresponds to a world-space
//   tangent-plane ray of length GTAO_RADIUS_WS.
// - For each sample, reconstruct world pos from depth and compute V = (Ps - P).
// - Horizon = max(dot(normalize(V), N)) among valid occluders.
// -----------------------------------------------------------------------------
static float EvaluateHorizonOneDir(
    float2 baseUV,
    float3 Pws,
    float3 Nws,
    float3 dirWS, // tangent-plane unit dir in world
    float noise01, // [0..1)
    float distFade)
{
    // Project the end point in this direction to get a per-pixel correct UV delta.
    // (This avoids needing Proj matrix element access & handles perspective naturally.)
    float radiusWS = GTAO_RADIUS_WS;

    // Fade can optionally shrink effective radius far away to stabilize noise
    // (feel free to remove if you want full AO distance)
    radiusWS *= lerp(1.0, 0.65, 1.0 - distFade);

    float3 endWS = Pws + dirWS * radiusWS;
    float4 endClip = WorldToClip(endWS);

    // If behind camera, fallback to small UV step (avoid NaNs)
    if (endClip.w <= 1e-6f)
        return 0.0;

    float2 endUV = ClipToUV(endClip);
    float2 deltaUV = endUV - baseUV;

    // If deltaUV is too tiny (far depth), bail early
    float deltaLen = length(deltaUV);
    if (deltaLen < 1e-6f)
        return 0.0;

    // March in UV space in GTAO_NUM_STEPS steps (stratified by noise)
    float horizon = -1.0;

    // Bias start to reduce self-occlusion
    float3 startWS = Pws + Nws * (GTAO_BIAS_WS * lerp(1.0, 2.0, 1.0 - distFade));

    [loop]
    for (int i = 1; i <= GTAO_NUM_STEPS; ++i)
    {
        float t01 = (float(i) - noise01) / float(GTAO_NUM_STEPS); // stratified
        t01 = saturate(t01);

        float2 suv = baseUV + deltaUV * t01;

        if (!IsInsideScreen(suv))
            break;

        float sceneDepth01 = g_GBufferDepth.SampleLevel(g_PointClampSampler, suv, 0);
        if (sceneDepth01 >= 0.999999)
            continue;

        float3 sceneWS = ReconstructWorldPos(suv, sceneDepth01);

        float3 Vws = sceneWS - startWS;
        float dist = length(Vws);
        if (dist < 1e-4f)
            continue;

        // Clamp max influence distance (helps reduce halos/noise)
        if (dist > min(GTAO_MAX_DIST_WS, radiusWS * 1.25))
            continue;

        float3 vDir = Vws / dist;

        // Optional occluder normal check (reduce ¡°backface occlusion¡±)
        float3 occN = UnpackNormal01(g_GBufferNormal.SampleLevel(g_PointClampSampler, suv, 0).xyz);

        // We want the occluder to face somewhat towards the receiver direction (-vDir)
        // If it's strongly facing away, skip
        if (dot(occN, -vDir) < GTAO_OCCLUDER_NDOT_V)
            continue;

        // Horizon candidate: how much the occluder rises above the tangent plane
        float h = dot(vDir, Nws); // [-1..1]
        horizon = max(horizon, h);
    }

    // Convert horizon to an occlusion contribution.
    // - Values below MIN_HORIZON_COS treated as no occlusion
    // - Clamp to [0..1]
    float occ = saturate((horizon - GTAO_MIN_HORIZON_COS) / max(1.0 - GTAO_MIN_HORIZON_COS, 1e-5));
    return occ;
}

// -----------------------------------------------------------------------------
// Main
// -----------------------------------------------------------------------------
void main(in PSInput PSIn, out float4 OutAO : SV_TARGET0)
{
    float2 uv = PSIn.UV;

    float depth01 = g_GBufferDepth.Sample(g_PointClampSampler, uv);

    // Sky / invalid
    if (depth01 >= 0.999999)
    {
        OutAO = float4(1, 1, 1, 1);
        return;
    }

    float3 ws = ReconstructWorldPos(uv, depth01);
    float3 N = UnpackNormal01(g_GBufferNormal.Sample(g_PointClampSampler, uv).xyz);

    // Distance fade (stability + reduces noisy far AO)
    float distFade = ViewDistanceFade(ws);
    if (distFade <= 0.001f)
    {
        OutAO = float4(1, 1, 1, 1);
        return;
    }

    // Build tangent basis in world
    float3 T, B;
    BuildOrthoBasis(N, T, B);

    // Blue-noise for direction rotation & step stratification
    uint2 pix = SVPosToPixel(PSIn.Pos);
    float noise = GetBlueNoiseDither(pix); // 0..1
    // Turn noise into a unit rotation vector
    float ang = noise * 6.2831853;
    float2 rot = float2(cos(ang), sin(ang));

    float occSum = 0.0;

    [loop]
    for (int d = 0; d < GTAO_NUM_DIRECTIONS; ++d)
    {
        float a = (float(d) / float(GTAO_NUM_DIRECTIONS)) * 6.2831853;
        float2 dir2 = float2(cos(a), sin(a));
        dir2 = Rotate2D(dir2, rot);

        // Convert 2D direction to a world-space tangent direction
        float3 dirWS = normalize(T * dir2.x + B * dir2.y);

        // Direction-specific stratification noise (decorrelate dirs)
        float dirNoise = frac(noise + float(d) * 0.6180339);

        occSum += EvaluateHorizonOneDir(
            uv,
            ws,
            N,
            dirWS,
            dirNoise,
            distFade);
    }

    float occAvg = occSum / float(GTAO_NUM_DIRECTIONS);

    // Apply intensity/contrast.
    // AO output: 1 = no occlusion, 0 = full occlusion
    float ao = 1.0 - saturate(pow(occAvg * GTAO_INTENSITY, GTAO_POWER));

    // Fade out far away
    ao = lerp(1.0, ao, distFade);

    OutAO = float4(ao.xxx, 1.0);
}

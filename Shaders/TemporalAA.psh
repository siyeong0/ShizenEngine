#include "Common.hlsli"

Texture2D<float4> g_CurrentColor;
Texture2D<float4> g_HistoryColor;

Texture2D<float2> g_Velocity; // uv-space (per-frame). If it's pixel-space, convert below.
Texture2D<float> g_Depth; // current depth (0..1). If reversed-Z, adjust comparisons.

Texture2D<float4> g_GBuffer2; // .a = coverage

SamplerState g_LinearClampSampler;

struct PSInput
{
    float4 Pos : SV_POSITION;
    float2 UV : TEXCOORD0;
};

// ----------------------------------------------------------------------------
// Main
// ----------------------------------------------------------------------------
void main(in PSInput PSIn, out float4 OutColor : SV_TARGET0)
{
    float2 uv = PSIn.UV;

    float2 velocity = g_Velocity.Sample(g_LinearClampSampler, uv);
    float2 uvPrev = uv - velocity;
	
    float4 currColor = g_CurrentColor.Sample(g_LinearClampSampler, uv);
    
    if (any(uvPrev < 0.0f) || any(uvPrev > 1.0f))
    {
        OutColor = float4(currColor.rgb, 1.0f);
        return;
    }
    
    float4 histColor = g_HistoryColor.Sample(g_LinearClampSampler, uvPrev);

    float4 left = g_CurrentColor.Sample(g_LinearClampSampler, uv, int2(-1, 0));
    float4 right = g_CurrentColor.Sample(g_LinearClampSampler, uv, int2(1, 0));
    float4 top = g_CurrentColor.Sample(g_LinearClampSampler, uv, int2(0, -1));
    float4 bottom = g_CurrentColor.Sample(g_LinearClampSampler, uv, int2(0, 1));
	
    float4 lower = min(currColor, min(min(left, right), min(top, bottom)));
    float4 upper = max(currColor, max(max(left, right), max(top, bottom)));
	
    histColor = clamp(histColor, lower, upper);
    
    float coverage = g_GBuffer2.Sample(g_LinearClampSampler, uv).a;
	
    float velocityLen = length(velocity * g_FrameCB.ViewportSize);
    float motionFade = saturate(1.0 - velocityLen * 0.25);

    float historyW_cov = lerp(0.2, 0.9, saturate(coverage));
    float historyW = historyW_cov * motionFade;
    
    float3 resolveColor = lerp(currColor, histColor, historyW).rgb;
    
    OutColor = float4(resolveColor, 1.0);
}
